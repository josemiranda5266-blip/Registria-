# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_USERNAME: Initial administrator username for system bootstrap (default: admin)
ADMIN_INITIAL_USERNAME="admin"

# ADMIN_INITIAL_EMAIL: Initial administrator email address
ADMIN_INITIAL_EMAIL="admin@registria.gob.ar"

# ADMIN_INITIAL_PASSWORD: Required for initial admin creation. Must be set.
ADMIN_INITIAL_PASSWORD=

# NODE_ENV: Application environment (development | production)
NODE_ENV="development"

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/registria)
DATABASE_URL=

# DATABASE_SSL: Enable SSL for PostgreSQL connection (true | false)
DATABASE_SSL="true"

# DATABASE_SSL_REJECT_UNAUTHORIZED: Validate SSL certificates (true | false)
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# DATABASE_CA: Optional SSL Certificate Authority contents or path for PostgreSQL
DATABASE_CA=

# CORS_ORIGIN: Allowed origin(s) for CORS in production. Required when NODE_ENV=production.
CORS_ORIGIN="http://localhost:3000"
