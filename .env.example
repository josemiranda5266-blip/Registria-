# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_USERNAME: Initial administrator username for system bootstrap (default: admin)
ADMIN_INITIAL_USERNAME="admin"

# ADMIN_INITIAL_EMAIL: Initial administrator email address
ADMIN_INITIAL_EMAIL="admin@registria.gob.ar"

# ADMIN_INITIAL_PASSWORD: Required for initial admin creation. Must be set.
ADMIN_INITIAL_PASSWORD=

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/registria)
DATABASE_URL=

# CORS_ORIGIN: Allowed origin(s) for CORS in production. Required when NODE_ENV=production.
CORS_ORIGIN="http://localhost:3000"
